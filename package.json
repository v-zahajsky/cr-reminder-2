{
	"name": "cr-reminder",
	"version": "2.0.0",
	"type": "module",
	"description": "Apify Actor that reminds developers about GitHub Pull Requests waiting for review and posts a compact message to Slack.",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@octokit/plugin-retry": "^7.1.2",
		"@octokit/plugin-throttling": "^9.3.2",
		"@octokit/rest": "^21.0.2",
		"@slack/web-api": "^7.8.0",
		"apify": "^3.4.2"
	},
	"devDependencies": {
		"@apify/eslint-config": "^1.0.0",
		"@apify/tsconfig": "^0.1.1",
		"@types/node": "^22.15.32",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^16.2.0",
		"prettier": "^3.5.3",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1",
		"vitest": "^2.1.4"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "set APIFY_MEMORY_MBYTES=0 && tsx src/main.ts",
		"build": "tsc",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
